APP_NAME="Lucy Ecuador Webview"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Guayaquil
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# =============================================================================
# CREDENCIALES GEA / OMNIAX (obligatorias para el chat operativo)
# Ver: php scripts/check_integrations.php  |  GET /api/v1/integrations/status
# =============================================================================
# Bearer Omniax — reemplaza accessToken de tools Jelou (Auth / Auth Gea)
GEA_OMNIAX_BASE_URL=https://api.geainternacional.com/test-ec
GEA_OMNIAX_CLIENT_ID=
GEA_OMNIAX_CLIENT_SECRET=
GEA_OMNIAX_ID_SERVICIO_MEDICO=297
GEA_OMNIAX_ID_SERVICIO_DENTAL=298
GEA_OMNIAX_TELEFONO_DEFAULT=0999999999
GEA_OMNIAX_PLAN_ASISTENCIA=ASISTENCIAS
GEA_OMNIAX_TIMEOUT=45
# Segmento país en URL validación cabina (vacío = test-ec si base_url es test-ec, si no ec)
GEA_OMNIAX_COUNTRY_PATH=

# Tool 2620 Aceptacion LOPDP — header api-key (NO es el Bearer Omniax; copiar desde Jelou Secret, no del MEMORY export)
GEA_LOPDP_BASE_URL=https://api.geainternacional.com
GEA_LOPDP_API_KEY=
GEA_LOPDP_APP_NAME=CHATBOT_LUCY
GEA_LOPDP_CANAL=CHATBOT

# Jelou Function legacy (tool asistencia-en-curso) — solo si llamas functions.jelou.ai en lugar de Omniax directo
GEA_JELOU_FUNCTION_ASISTENCIAS_URL=https://functions.jelou.ai/gea-lucy/asistenciasEnCurso
GEA_JELOU_FUNCTION_USER=
GEA_JELOU_FUNCTION_PASSWORD=

# =============================================================================
# JELOU PLATAFORMA (comercial / Datum / Pay)
# =============================================================================
JELOU_PROJECT_ID=01j5661e5gaf6330435zh3bzjx
JELOU_API_BASE_URL=https://api.jelou.ai
JELOU_API_TOKEN=
JELOU_DATUM_TABLE_VENTA=1435
JELOU_DATUM_TABLE_INMEDIATA=2254
JELOU_DATUM_TABLE_IA_ROUTER=2756

JELOU_PAY_BASE_URL=https://payments.jelou.ai/api/v1
JELOU_PAY_APP_ID=98414565-df66-4bab-9e12-dfef65e56800
JELOU_PAY_BEARER=
JELOU_PAY_BOT_ID=593958637937
JELOU_PAY_GATEWAY_ID=
JELOU_PAY_TAX_PERCENT=15
JELOU_PAY_PLAN_EDOCTOR=302
JELOU_PAY_PLAN_VIAJA=348
JELOU_PAY_PLAN_INMEDIATA=300

# =============================================================================
# LUCY IA (webview Fase 4 — opcional; sin key = modo guiado)
# =============================================================================
LUCY_IA_ENABLED=true
LUCY_IA_API_KEY=
LUCY_IA_BASE_URL=https://api.openai.com/v1
LUCY_IA_MODEL=gpt-4o-mini
LUCY_IA_TIMEOUT=60
LUCY_IA_MAX_HISTORY=12

VITE_APP_NAME="${APP_NAME}"
VITE_GEA_ID_SERVICIO_DEFAULT=
VITE_OMNIAX_ID_SERVICIO_MEDICO="${GEA_OMNIAX_ID_SERVICIO_MEDICO}"
VITE_OMNIAX_ID_SERVICIO_DENTAL="${GEA_OMNIAX_ID_SERVICIO_DENTAL}"
