        "content": "const rawUser = String($user.get('id') || '');\nconst rawMsg = String(($message && $message.get && $message.get('text')) || '');\nconst pick = (raw) => {\n  const digits = String(raw || '').replace(/\\D+/g, '');\n  if (digits.startsWith('593') && digits.length >= 12) return '0' + digits.slice(3, 13);\n  if (digits.length === 10 && digits.startsWith('09')) return digits;\n  if (digits.length === 9) return '0' + digits;\n  return '';\n};\nconst local = pick(rawUser) || pick(rawMsg);\n$memory.set('telefono_webview', local, 86400);",
