        "title": "Normalizar teléfono",
        "content": "const raw = String($user.get('id') || '');\nconst digits = raw.replace(/\\D+/g, '');\nlet local = '';\nif (digits.startsWith('593') && digits.length >= 12) {\n  local = '0' + digits.slice(3, 13);\n} else if (digits.length === 10 && digits.startsWith('09')) {\n  local = digits;\n} else if (digits.length === 9) {\n  local = '0' + digits;\n}\n$memory.set('telefono_webview', local, 86400);",
