    {
      "id": "fcOb0YwlWNGgWOTN9zJ5c",
      "title": "brain.nodes.code_name v2",
      "configuration": {
        "title": "brain.nodes.code_name v2",
        "content": "const identificacion = $memory.get('VA_identificacion', '')\nconst is_valid_cedula = validLegalIdEc(identificacion)\n\n$memory.set('is_valid_cedula', is_valid_cedula, 86400)\n\n// Función del dígito verificador para cédulas ecuatorianas\nfunction validLegalIdEc(legalId) {\n    if (typeof (legalId) == 'string' && legalId.length == 10 && /^\\d+$/.test(legalId)) {\n        var digitos = legalId.split('').map(Number)\n        var codigo_provincia = digitos[0] * 10 + digitos[1]\n\n        if (codigo_provincia >= 1 && (codigo_provincia <= 24 || codigo_provincia == 30)) {\n            var digito_verificador = digitos.pop()\n\n            var digito_calculado = digitos.reduce(\n                function (valorPrevio, valorActual, indice) {\n                    return valorPrevio - (valorActual * (2 - indice % 2)) % 9 - (valorActual == 9) * 9;\n                }, 1000) % 10\n            return digito_calculado === digito_verificador\n        }\n    }\n    return false\n}",
        "instruction": "Migrated from legacy CODE. Same business logic; Memory v2 API.",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        5807,
        -131
      ]
    },
